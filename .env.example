# Private Vercel Blob store. Pending clips must not be public URLs.
# vercel blob create-store movementizer-ground --access private
BLOB_READ_WRITE_TOKEN=

# Neon Postgres connection string from the Vercel Marketplace integration.
DATABASE_URL=

# Long random string. Gates /admin and /api/admin. Do not commit a real value.
ADMIN_TOKEN=

# Optional. If empty, new clips stay pending and the automatic check is skipped.
# vercel ai-gateway api-keys create
AI_GATEWAY_API_KEY=

# Optional. Default is google/gemini-2.5-flash (image input, text output).
GROUND_AI_MODEL=google/gemini-2.5-flash
